{
  "mobile": {
    "id": "android-netlink",
    "android": {
      "sources": ["android/*.kt"],
      "class": "AndroidNetPlugin",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "POST_NOTIFICATIONS",
        "QUERY_ALL_PACKAGES"
      ],
      "application": [
        "<service android:name=\"dev.mygo.NetLinkService\" android:permission=\"android.permission.BIND_VPN_SERVICE\" android:exported=\"false\" android:foregroundServiceType=\"specialUse\"><intent-filter><action android:name=\"android.net.VpnService\" /></intent-filter><property android:name=\"android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE\" android:value=\"netlink\" /></service>"
      ]
    }
  }
}
